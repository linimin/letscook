{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "./hooks/cook-post-mcp-continue.sh",
        "matcher": "MCP"
      }
    ],
    "subagentStop": [
      {
        "command": "./hooks/cook-subagent-continue.sh",
        "matcher": "completion-(bootstrapper|regrounder|implementer|reviewer|auditor|stop-judge)",
        "loop_limit": null
      }
    ],
    "stop": [
      {
        "command": "./hooks/cook-stop-continue.sh",
        "matcher": "Stop",
        "loop_limit": null
      }
    ]
  }
}
