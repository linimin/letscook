{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "./hooks/cook-post-mcp-continue.sh",
        "matcher": "MCP:.*(submit_role_result|claim_workflow_dispatch|get_workflow_dispatch|confirm_cook_handoff|start_cook_workflow)"
      }
    ],
    "subagentStop": [
      {
        "command": "./hooks/cook-subagent-continue.sh",
        "matcher": "completion-(bootstrapper|regrounder|implementer|reviewer|auditor|stop-judge)",
        "loop_limit": null
      }
    ],
    "stop": [
      {
        "command": "./hooks/cook-stop-continue.sh",
        "matcher": "Stop",
        "loop_limit": null
      }
    ]
  }
}
